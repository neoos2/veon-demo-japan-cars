---
import Icon from "./Icon.astro";
import { faqs } from "../data/site";
---
<section id="faq" class="section faq" aria-labelledby="faq-title" data-rec="R-UX10">
  <div class="container grid">
    <div class="side"><h2 id="faq-title" class="head" data-reveal>Питають перед замовленням</h2></div>
    <div class="list" data-reveal style="--reveal-delay:60ms">
      {faqs.map((f) => (
        <details>
          <summary><h3>{f.q}</h3><Icon name="chevron" size={22} class="chev" /></summary>
          <div class="answer">{f.a.map((p) => <p>{p}</p>)}</div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq { padding-top: 0; }
  .side { align-self: start; }
  .head { max-width: 14ch; }
  .list { border-top: 2px solid var(--color-text); }
  details { border-bottom: 1px solid var(--color-rule); }
  summary { display: flex; align-items: center; justify-content: space-between; gap: var(--s-16); min-height: 64px; padding-block: var(--s-16); cursor: pointer; list-style: none; }
  summary::-webkit-details-marker { display: none; }
  summary h3 { font-size: var(--fs-20); }
  summary:hover h3 { text-decoration: underline; text-decoration-color: var(--color-primary); text-underline-offset: 0.2em; }
  summary :global(.chev) { flex: none; transition: transform var(--dur-mid) var(--ease-out); }
  details[open] summary :global(.chev) { transform: rotate(180deg); }
  .answer { display: grid; gap: var(--s-12); padding-bottom: var(--s-24); max-width: var(--measure); color: var(--color-text-muted); }
  details[open] .answer { animation: faq-open var(--dur-mid) var(--ease-out); }
  @keyframes faq-open { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
  @media (min-width: 1024px) {
    .side { grid-column: 1 / span 4; position: sticky; top: calc(var(--header-h) + var(--s-40)); }
    .list { grid-column: 6 / span 7; }
  }
  @media (prefers-reduced-motion: reduce) {
    details[open] .answer { animation: none; }
    summary :global(.chev) { transition: none; }
  }
</style>
